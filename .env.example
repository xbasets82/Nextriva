# Añadir aquí solo nombres de variables y valores ficticios aprobados por incremento.
# Copia a .env.local y reemplaza estos marcadores por credenciales locales.
NEXTRIVA_DEV_USER=replace_with_local_dev_user
NEXTRIVA_DEV_PASSWORD=replace_with_local_dev_password
NEXTRIVA_TEST_USER=replace_with_local_test_user
NEXTRIVA_TEST_PASSWORD=replace_with_local_test_password
DATABASE_URL=postgresql://replace_with_local_dev_user:replace_with_local_dev_password@127.0.0.1:5432/nextriva_dev
TEST_DATABASE_URL=postgresql://replace_with_local_test_user:replace_with_local_test_password@127.0.0.1:5433/nextriva_test
