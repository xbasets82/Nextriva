{
  "name": "nextriva",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "24.22.0",
    "pnpm": "10.34.7"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "test:audit-baseline": "node --test scripts/audit-baseline.test.mjs",
    "test:backup-demo": "node --test scripts/backup-demo-postgres.test.mjs scripts/run-demo-backup.test.mjs",
    "test:http": "pnpm --filter @nextriva/api test:http",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present build",
    "db:seed:dev": "pnpm --filter @nextriva/api db:seed:dev",
    "db:seed:dev:clean": "pnpm --filter @nextriva/api db:seed:dev:clean",
    "db:seed:demo": "pnpm --filter @nextriva/api db:seed:demo",
    "lint": "eslint \"apps/**/*.{ts,tsx}\"",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,json}\" \"*.{json,js,mjs,cjs}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,json}\" \"*.{json,js,mjs,cjs}\"",
    "check:staged": "lint-staged",
    "prepare": "husky",
    "api:types": "node scripts/generate-api-types.mjs",
    "api:types:check": "node scripts/generate-api-types.mjs --check"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript-eslint": "8.71.2"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,mjs,cjs}": [
      "eslint",
      "prettier --check"
    ],
    "**/*.json": [
      "prettier --check"
    ],
    "docs/tfm/**/*.md": [
      "prettier --check"
    ]
  }
}
