{
  "name": "@nextriva/api",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:http": "vitest run --config vitest.integration.config.ts src/health/health.http.integration.test.ts",
    "test:integration": "node --env-file=../../.env.local ../../scripts/test-integration.mjs",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-express": "12.0.3",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "dotenv": "17.2.3",
    "pg": "8.16.3",
    "pino": "10.4.0",
    "prisma": "7.9.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
