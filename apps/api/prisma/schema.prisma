generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  MANAGER
  COLLABORATOR

  @@map("user_role")
}

enum PromotionStatus {
  ACTIVE
  ARCHIVED

  @@map("promotion_status")
}

enum PromotionPhase {
  PLANNING
  COMMERCIALIZATION
  EXECUTIVE_PROJECT
  CONSTRUCTION
  PRE_HANDOVER
  HANDOVER
  AFTER_SALES

  @@map("promotion_phase")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName    String   @map("first_name") @db.VarChar(100)
  lastName     String   @map("last_name") @db.VarChar(150)
  email        String   @unique(map: "users_email_key") @db.VarChar(320)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdIncidents      Incident[] @relation("IncidentCreator")
  assignedIncidents     Incident[] @relation("IncidentAssignee")
  incidentComments      IncidentComment[]
  incidentActivities    IncidentActivity[]
  sessions              Session[]
  promotionParticipants PromotionParticipant[]

  @@map("users")
}

model Session {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique(map: "sessions_token_hash_key") @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, expiresAt], map: "sessions_user_id_expires_at_idx")
  @@map("sessions")
}

model Promotion {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String                 @db.VarChar(150)
  description  String?                @db.VarChar(1000)
  location     String?                @db.VarChar(200)
  status       PromotionStatus        @default(ACTIVE)
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  incidents    Incident[]
  phases       PromotionPhaseRecord[]
  participants PromotionParticipant[]

  @@map("promotions")
}

model PromotionPhaseRecord {
  promotionId String         @map("promotion_id") @db.Uuid
  phase       PromotionPhase
  promotion   Promotion      @relation(fields: [promotionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([promotionId, phase], map: "promotion_phases_pkey")
  @@map("promotion_phases")
}

model PromotionParticipant {
  promotionId String    @map("promotion_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  joinedAt    DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([promotionId, userId], map: "promotion_participants_pkey")
  @@index([userId, promotionId], map: "promotion_participants_user_id_promotion_id_idx")
  @@map("promotion_participants")
}

enum IncidentCategory {
  STRUCTURE
  ENVELOPE
  INSTALLATIONS
  FINISHES
  CARPENTRY
  COMMON_AREAS
  CLEANING
  SAFETY
  OTHER
  @@map("incident_category")
}
enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
  @@map("incident_priority")
}
enum IncidentStatus {
  OPEN
  IN_PROGRESS
  PENDING_VALIDATION
  CLOSED
  @@map("incident_status")
}
enum IncidentEventType {
  CREATED
  ASSIGNED
  REASSIGNED
  STATUS_CHANGED
  @@map("incident_event_type")
}
model Incident {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publicCode String @unique(map: "incidents_public_code_key") @default(dbgenerated("next_incident_public_code()")) @map("public_code")
  promotionId String @map("promotion_id") @db.Uuid
  originPhase PromotionPhase @map("origin_phase")
  title String @db.VarChar(150)
  description String @db.VarChar(5000)
  category IncidentCategory
  priority IncidentPriority
  status IncidentStatus @default(OPEN)
  createdById String @map("created_by_id") @db.Uuid
  assignedToId String? @map("assigned_to_id") @db.Uuid
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  createdBy User @relation("IncidentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo User? @relation("IncidentAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  activities IncidentActivity[]
  comments IncidentComment[]
  @@index([promotionId, status, createdAt])
  @@index([assignedToId, status])
  @@map("incidents")
}
model IncidentActivity {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId String @map("incident_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  eventType IncidentEventType @map("event_type")
  changes Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([incidentId, createdAt])
  @@map("incident_activities")
}

model IncidentComment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId String @map("incident_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid
  body String @db.VarChar(2000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)
  @@index([incidentId, createdAt, id])
  @@map("incident_comments")
}
